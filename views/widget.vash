@html.extend('layout', function () {
  @html.append('content', function () {
    <h1>Generate TheOldNet Webring Widget</h1>
    <p>
      You don't have to join the webring to add this banner to your website, but
      if you do want to have your site included in the webring you need to
      <a href="/submit">submit your page</a> and then regenerate this code using
      your Website Id.
    </p>
    <form action="/widget" method="GET">
      Website Id (from email):
      <br>
      <input type="text" name="websiteId" value="@model.websiteId">
      <br>
      <br>
      <input type="submit" value="Generate widget!">
    </form>

    @if (model.error) {
      <hr/>
      <font size="5" color="red">@model.error</font>
      <hr/>
    }

    @if (model.generatedBannerWidget) {
      <hr/>
      <h2>TheOldNet Webring Widgets for @model.website.name</h2>
      @if (model.pendingApproval === true) {
        <p>
          <b>This site is still pending review.</b> You can embed the widget
          now; you'll be emailed when you're officially added to the webring.
        </p>
      }
      <h3>Banner Widget</h3>
      <p>Copy this code and paste it on your website</p>
      <textarea cols="130" rows="10">@model.generatedBannerWidget</textarea>
      <br>
      <p>
        Preview using <b>your</b> banner (on your site the widget shows
        <b>other</b> members so visitors can discover them):
      </p>
      @html.raw(model.generatedBannerWidgetPreview)
      <hr/>
    }

    @if (model.generatedTextOnlyWidget) {
      <h3>Text Only Widget</h3>
      <p>Copy this code and paste it on your website</p>
      <textarea cols="130" rows="6">@model.generatedTextOnlyWidget</textarea>
      <br>
      <p>This is what the widget is going to look like:</p>
      @html.raw(model.generatedTextOnlyWidget)
      <hr/>
    }

    @if (model.showAnonymousWidgets) {
      <hr/>
      <h2>TheOldNet Webring Widgets</h2>
      <h3>Banner Widget</h3>
      <p>Copy this code and paste it on your website</p>
      <textarea cols="130" rows="10">@model.anonymousBannerWidget</textarea>
      <br>
      <p>This is what the widget is going to look like:</p>
      @html.raw(model.anonymousBannerWidgetPreview)
      <hr/>

      <h3>Text Only Widget</h3>
      <p>Copy this code and paste it on your website</p>
      <textarea cols="130" rows="6">@model.anonymousTextOnlyWidget</textarea>
      <br>
      <p>This is what the widget is going to look like:</p>
      @html.raw(model.anonymousTextOnlyWidget)
      <hr/>
    }

    <br>
    <a href="/">Back to HOME</a>
  })
})
