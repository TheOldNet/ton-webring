@html.extend('admin-layout', function () {
  @html.append('content', function () {
    <div class="admin-shell admin-shell--wide">
    <script>
      function validateDeny(form) {
        return confirm('Are you sure you want to deny this request?');
      }

      function validateApprove(form) {
        return confirm('Are you sure you want to approve this request? You will go to the email form next.');
      }

      function validateClearBanner(form) {
        return confirm('Are you sure you want to clear this banner?');
      }

      function validateRemove(form) {
        return confirm('Are you sure you want to remove this website from the Webring?');
      }

      function validateConfirmBanner(form) {
        return confirm('Are you sure this website has the banner embedded?');
      }

      function validateToggleRetro(form) {
        return confirm('Are you sure you want to toggle if the site is retro?');
      }
    </script>

    <h1>Admin</h1>
    <p class="admin-nav"><a href="/admin/email-template">Edit approval email template</a></p>

    <h2>WebRing Requests</h2>
    <div class="admin-table-wrap">
    <table class="admin-table admin-table--requests">
      <thead>
        <tr>
          <th>Submitted</th>
          <th>ID</th>
          <th>URL</th>
          <th>Title</th>
          <th>Description</th>
          <th>Email</th>
        </tr>
      </thead>
      @model.requests.forEach(function (request) {
        <tr class="admin-row-primary">
          <td>@request.submittedAt</td>
          <td class="admin-mono">@request.id</td>
          <td><a href="@request.url" target="_blank">@request.url</a></td>
          <td>@request.name</td>
          <td>@request.description</td>
          <td><a href="mailto:@request.email">@request.email</a></td>
        </tr>
        <tr class="admin-row-secondary">
          <td colspan="6">
            <div class="admin-row-secondary-inner">
              <div class="admin-table-banner">
                @if (request.banner) {
                  <img src="@request.banner" alt="@request.name">
                } else {
                  <img src="/request-banner/@request.id" alt="@request.name">
                }
              </div>
              <div class="admin-row-flag">
                <span class="admin-row-flag-label">Is Retro</span>
                @if (request.isVintage === true) {
                  <span>YES</span>
                } else {
                  <span>NO</span>
                }
              </div>
              <div class="admin-row-flag">
                <span class="admin-row-flag-label">Banner</span>
                @if (request.banner) {
                  <span>custom URL</span>
                } else {
                  <span>auto</span>
                }
              </div>
              <div class="admin-table-actions">
                <form action="/admin_action" method="POST" onsubmit="return validateDeny(this);">
                  <input type="hidden" name="id" value="@request.id" />
                  <input type="submit" name="deny" value="Deny request" />
                </form>
                <form action="/admin_action" method="POST" onsubmit="return validateApprove(this);">
                  <input type="hidden" name="id" value="@request.id" />
                  <input type="submit" name="approve" value="Approve" />
                </form>
                <form action="/admin_action" method="POST" onsubmit="return validateClearBanner(this);">
                  <input type="hidden" name="id" value="@request.id" />
                  <input type="submit" name="clear_banner" value="Clear Banner" />
                </form>
              </div>
            </div>
          </td>
        </tr>
      })
    </table>
    </div>

    <h2>Current WebRing Websites</h2>
    <div class="admin-table-wrap">
    <table class="admin-table admin-table--sites">
      <thead>
        <tr>
          <th>Approved</th>
          <th>ID</th>
          <th>URL</th>
          <th>Title</th>
          <th>Description</th>
          <th>Email</th>
          <th>Emailed?</th>
          <th>Has Embed</th>
        </tr>
      </thead>
      @model.current.forEach(function (site) {
        <tr class="admin-row-primary">
          <td>@site.approvedAt</td>
          <td class="admin-mono">@site.id</td>
          <td><a href="@site.url" target="_blank">@site.url</a></td>
          <td>@site.name</td>
          <td>@site.description</td>
          <td><a href="/mailto-form/@site.id">@site.email</a></td>
          <td>
            @if (site.approvalEmailed === true) {
              <span>YES</span>
            } else {
              <span>NO</span>
            }
          </td>
          <td>
            @if (site.hasWidget === true) {
              <span>YES</span>
            } else {
              <span>NO</span>
            }
          </td>
        </tr>
        <tr class="admin-row-secondary">
          <td colspan="8">
            <div class="admin-row-secondary-inner">
              <div class="admin-table-banner">
                <img src="@(site.bannerSrc || ('/assets/banners/' + site.banner))" alt="@site.name">
              </div>
              <div class="admin-row-flag">
                <span class="admin-row-flag-label">Is Retro</span>
                @if (site.isVintage === true) {
                  <span>YES</span>
                } else {
                  <span>NO</span>
                }
              </div>
              <div class="admin-row-flag">
                <span class="admin-row-flag-label">Banner</span>
                @if (site.bannerIsCustom === true) {
                  <span>custom</span>
                } else {
                  <span>auto</span>
                }
              </div>
              <div class="admin-table-actions">
                <a href="/admin/edit/@site.id">Edit</a>
                <form action="/admin_action" method="POST" onsubmit="return validateRemove(this);">
                  <input type="hidden" name="id" value="@site.id" />
                  <input type="submit" name="remove" value="Remove website" />
                </form>
                <form action="/admin_action" method="POST" onsubmit="return validateConfirmBanner(this);">
                  <input type="hidden" name="id" value="@site.id" />
                  <input type="submit" name="confirm_banner" value="Confirm embed" />
                </form>
                <form action="/admin_action" method="POST" onsubmit="return validateToggleRetro(this);">
                  <input type="hidden" name="id" value="@site.id" />
                  <input type="submit" name="toggle_retro" value="Toggle Retro" />
                </form>
                <a href="/mailto-form/@site.id">Email</a>
              </div>
            </div>
          </td>
        </tr>
      })
    </table>
    </div>
    <script>
      (function () {
        var KEY = 'tonWebringAdminScroll';
        function save() {
          try {
            sessionStorage.setItem(KEY, String(window.scrollY || window.pageYOffset || 0));
          } catch (e) {}
        }
        function restore() {
          try {
            var raw = sessionStorage.getItem(KEY);
            if (raw == null || raw === '') return;
            var y = parseInt(raw, 10);
            if (!isFinite(y) || y < 0) return;
            window.scrollTo(0, y);
          } catch (e) {}
        }
        window.addEventListener('pagehide', save);
        window.addEventListener('beforeunload', save);
        document.addEventListener('click', function (ev) {
          var t = ev.target;
          if (!t) return;
          var a = t.closest ? t.closest('a[href]') : null;
          if (a) save();
        });
        document.addEventListener('submit', save);
        // Restore after layout; again after images so row heights settle.
        function scheduleRestore() {
          requestAnimationFrame(function () {
            restore();
            requestAnimationFrame(restore);
          });
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', scheduleRestore);
        } else {
          scheduleRestore();
        }
        window.addEventListener('load', restore);
      })();
    </script>
    </div>
  })
})
