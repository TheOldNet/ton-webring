@model.randomSites.forEach(function (site, index) {
  @{
    var isLast = index === (model.randomSites.length - 1);
  }
  <a href="@site.url"><img src="@site.bannerSrc" alt="@site.name" border="0"></a><br><a href="@site.url"><strong>@site.name</strong></a><br>@site.description
  @if (!isLast) {
    <br><hr/>  
  }
})

