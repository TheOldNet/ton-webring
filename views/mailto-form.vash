@html.extend('layout', function () {
  @html.append('content', function () {
    <h1>Mail to the owner of @model.current.name:</h1>
    <p><a href="@model.current.url" target="_blank">@model.current.url</a></p>
    <p>Member ID: <code>@model.current.id</code></p>
    @if (model.approvalEmailed) {
      <p><b>Approval email:</b> marked as sent.</p>
    } else {
      <p><b>Approval email:</b> not marked as sent yet.</p>
    }

    <p>
      <a href="/admin/email-template">Edit email template (this browser)</a>
      &nbsp;|&nbsp;
      <a href="/admin">Back to admin</a>
    </p>
    <p id="prefs-status"></p>

    <form id="gmail-form" action="https://mail.google.com/mail/u/5/?view=cm" method="get" enctype="text/plain" target="_blank">
      <input type="hidden" name="to" value="@model.current.email" />
      <input type="hidden" name="fs" value="1" />
      <input type="hidden" name="tf" value="cm" />
      <input type="hidden" name="source" value="mailto" />

      <label for="gmailUserIndex">Gmail user index (u/N):
        <input type="number" id="gmailUserIndex" min="0" max="20" value="5" />
      </label>
      <br><br>

      <label for="su">Subject:
        <input type="text" name="su" id="su" style="width: 40em;" />
      </label>
      <br><br>
      <label>Message:</label>
      <br />
      <textarea name="body" id="body" rows="18" cols="100"></textarea>
      <br><br>
      <input type="submit" name="submit" value="Open in Gmail" />
    </form>

    <br>
    <form action="/admin_action" method="POST" style="display: inline;">
      <input type="hidden" name="id" value="@model.current.id" />
      @if (model.approvalEmailed) {
        <input type="submit" name="clear_emailed" value="Clear emailed flag" />
      } else {
        <input type="submit" name="mark_emailed" value="I sent the email — mark as emailed" />
      }
    </form>

    <script src="/assets/admin-email-prefs.js"></script>
    <script>
      (function () {
        var site = {};
        try {
          site = JSON.parse(decodeURIComponent("@model.siteJsonEncoded"));
        } catch (e) {}
        TonWebringEmailPrefs.initMailto(site);
      })();
    </script>
  })
})
