@html.extend('layout', function () {
  @html.append('content', function () {
    <center>
      <a href="/submit">Submit a Website</a> | <a href="/widget">Generate a Widget for your Website</a>
      <br>
      <h3>Browse the Webring using:</h3>
      <table cellspacing="5" cellpadding="10" border="1" width="480" bgcolor="#DDDDDD">
        <tbody>
          <tr>
            <td align="center">
              <a href="/frameset">
                <font color="blue">
                  The
                </font>
                <font color="red">
                  Frameset
                </font>
                <font color="blue">
                  Browser
                </font>
              </a>
            </td>
          </tr>
        </tbody>
      </table>
      <h3>Webring websites</h3>
      <p>
        <a href="/?page=@model.prevPage">&lt;&lt; Prev</a>
        &nbsp;|&nbsp;
        Page @model.pageDisplay of @model.totalPages
        &nbsp;(@model.total sites)
        &nbsp;|&nbsp;
        <a href="/?page=@model.nextPage">Next &gt;&gt;</a>
      </p>
      <table cellspacing="5" cellpadding="5" border="1" width="480">
        <tbody>
          <tr>
            <td>
              @html.extend('website-list', function () {})
            </td>
          </tr>
        </tbody>
      </table>
      <p>
        <a href="/?page=@model.prevPage">&lt;&lt; Prev</a>
        &nbsp;|&nbsp;
        Page @model.pageDisplay of @model.totalPages
        &nbsp;|&nbsp;
        <a href="/?page=@model.nextPage">Next &gt;&gt;</a>
      </p>

      <p>Click <a href="/random/navigate">HERE</a> for a <b>random</b> website!</p>
    </center>
  })
})
