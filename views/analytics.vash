@html.extend('admin-layout', function () {
  @html.append('content', function () {
    <div class="admin-shell admin-shell--wide">
    <h1>Click analytics</h1>
    <p class="admin-nav"><a href="/admin">← Back to admin</a></p>

    <p class="admin-analytics-note">
      Banner clicks go through <code>/widget/…/navigate</code>.
      <code>nav_*</code> = full-page leave (no-JS / vintage).
      <code>widget_nav_*</code> = modern in-place banner swap.
      Embed presence is on the main admin list (Last Embed Seen / Embed Page).
    </p>

    <h2>Totals by type</h2>
    <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Count</th>
        </tr>
      </thead>
      <tbody>
      @if (model.typeCounts && model.typeCounts.length > 0) {
        @model.typeCounts.forEach(function (row) {
          <tr>
            <td class="admin-mono">@row.type</td>
            <td>@row.count</td>
          </tr>
        })
      } else {
        <tr><td colspan="2">No events yet.</td></tr>
      }
      </tbody>
    </table>
    </div>

    <h2>Top embed impressions</h2>
    <p class="admin-analytics-note">
      Times each member’s <code>/widget/…/image</code> was loaded (people who saw the embed, whether or not they clicked).
    </p>
    <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Embed owner</th>
          <th>ID</th>
          <th>Image loads</th>
        </tr>
      </thead>
      <tbody>
      @if (model.impressionRows && model.impressionRows.length > 0) {
        @model.impressionRows.forEach(function (row) {
          <tr>
            <td>@row.name</td>
            <td class="admin-mono">@row.id</td>
            <td>@row.embedImageLoads</td>
          </tr>
        })
      } else {
        <tr><td colspan="3">No image loads recorded yet.</td></tr>
      }
      </tbody>
    </table>
    </div>

    <h2>Top embedders</h2>
    <p class="admin-analytics-note">
      Members whose embed drives the most outbound clicks (banner click or Previous/Next/Random leave).
    </p>
    <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Embed owner</th>
          <th>ID</th>
          <th>Outbound clicks</th>
        </tr>
      </thead>
      <tbody>
      @if (model.embedderRows && model.embedderRows.length > 0) {
        @model.embedderRows.forEach(function (row) {
          <tr>
            <td>@row.name</td>
            <td class="admin-mono">@row.fromWebsiteId</td>
            <td>@row.count</td>
          </tr>
        })
      } else {
        <tr><td colspan="3">No outbound clicks yet.</td></tr>
      }
      </tbody>
    </table>
    </div>

    <h2>Top destinations</h2>
    <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Site</th>
          <th>ID</th>
          <th>Clicks / views</th>
        </tr>
      </thead>
      <tbody>
      @if (model.destRows && model.destRows.length > 0) {
        @model.destRows.forEach(function (row) {
          <tr>
            <td>@row.name</td>
            <td class="admin-mono">@row.toWebsiteId</td>
            <td>@row.count</td>
          </tr>
        })
      } else {
        <tr><td colspan="3">No destinations yet.</td></tr>
      }
      </tbody>
    </table>
    </div>

    <h2>Recent events</h2>
    <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>When (UTC)</th>
          <th>Type</th>
          <th>From embed</th>
          <th>To site</th>
          <th>To URL</th>
          <th>Referer</th>
          <th>Old UA?</th>
        </tr>
      </thead>
      <tbody>
      @if (model.recentRows && model.recentRows.length > 0) {
        @model.recentRows.forEach(function (row) {
          <tr>
            <td class="admin-mono">@row.when</td>
            <td class="admin-mono">@row.type</td>
            <td>@row.fromName</td>
            <td>@row.toName</td>
            <td class="admin-col-embed-page">
              @if (row.toUrl) {
                <a href="@row.toUrl" target="_blank" rel="noopener noreferrer">@row.toUrl</a>
              } else {
                <span>—</span>
              }
            </td>
            <td class="admin-col-embed-page">
              @if (row.referer) {
                <a href="@row.referer" target="_blank" rel="noopener noreferrer" title="@row.referer">@row.referer</a>
              } else {
                <span>—</span>
              }
            </td>
            <td>
              @if (row.isOldBrowser === true) {
                <span>YES</span>
              } else {
                <span>NO</span>
              }
            </td>
          </tr>
        })
      } else {
        <tr><td colspan="7">No events yet.</td></tr>
      }
      </tbody>
    </table>
    </div>
    </div>
  })
})
