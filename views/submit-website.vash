@html.extend('layout', function () {
  @html.append('content', function () {
    @if (model.success === true) {
      <h1>Your website was submitted successfully!</h1>
      <p>
        <b>Your submission is subject to review and approval</b>, but you can
        start using your webring embed today — paste the code below onto your
        site now.
      </p>
      <p>
        We'll email you when you're officially added to the webring.
        Websites that don't add the embed may be removed.
      </p>
      <p>
        Your Website Id:
        <code>@model.websiteId</code>
        (save this — you can also regenerate the code anytime at
        <a href="/widget?websiteId=@model.websiteId">/widget</a>)
      </p>

      @if (model.generatedBannerWidget) {
        <hr/>
        <h2>Your Webring Embed</h2>
        <h3>Banner Widget</h3>
        <p>Copy this code and paste it on your website:</p>
        <textarea cols="130" rows="10">@model.generatedBannerWidget</textarea>
        <br>
        <p>
          Preview (on your site the widget shows <b>other</b> members so
          visitors can discover them):
        </p>
        @html.raw(model.generatedBannerWidgetPreview)
        <hr/>
      }

      @if (model.generatedTextOnlyWidget) {
        <h3>Text Only Widget</h3>
        <p>Copy this code and paste it on your website:</p>
        <textarea cols="130" rows="6">@model.generatedTextOnlyWidget</textarea>
        <br>
        <p>This is what the text widget looks like:</p>
        @html.raw(model.generatedTextOnlyWidget)
        <hr/>
      }
    }

    @if (!model.success) {
      <h1>Submit a website</h1>
      <p>Sorry, but for security reasons, submitting websites in old browsers doesn't work, please use a modern browser to do that.</p>
      <p>Submit your website using the form below</p>

      @if (model.errors && model.errors.length) {
        <h3>Please review the following issues:</h3>
        <font color="red">
          <ul>
            @model.errors.forEach(function (item) {
              <li>@item</li>
            })
          </ul>
        </font>
      }

      <form action="/submit" method="POST">
        <label for="email">Your email address <font color="red">*</font>:</label><br>
        <input type="text" id="email" name="email" value="" placeholder="you@domain.com" width="500" style="width: 500px"><br><br>
        <label for="sitename">Website name <font color="red">*</font>:</label><br>
        <input type="text" id="sitename" name="sitename" value="" placeholder="My cool retro site" width="500" style="width: 500px"><br><br>
        <label for="siteurl">Website URL <font color="red">*</font>:</label><br>
        <input type="text" id="siteurl" name="siteurl" value="" placeholder="http://my.coolsite.com" width="500" style="width: 500px"><br><br>
        <label for="bannerurl">Banner Image URL (468x60 pixels, 256 colors, jpeg or gif)<sup>(1)</sup>:</label><br>
        <input type="text" id="bannerurl" name="bannerurl" value="" placeholder="http://mysite.com/banner.gif" width="500" style="width: 500px"><br><br>
        <label for="description">Brief website description <font color="red">*</font>:</label><br>
        <input type="text" id="description" name="description" value="" placeholder="Your source for cool stuff" width="500" style="width: 500px"><br><br>
        <input type="checkbox" id="isretro" name="isretro"/><label for="isretro">My website is compatible with Old Browsers<sup>(2)</sup></label>
        <br><br>
        @html.raw(model.captcha)<br>
        <input type="submit" value="Submit">
      </form>
      <ol>
        <li>
          Don't have a custom banner? No problem, we will generate a custom banner using your Fav Icon, Title, Description and URL!
          <br><br>
          We highly encourage you to add a favicon to your site because we are able to generate a much better banner using the icon. We automatically set a background color and text color based on your favicon's palette!
          <br>
          Read <a href="https://www.w3schools.com/html/html_favicon.asp" target="_blank" rel="noopener noreferrer">this</a> to learn how to add a favicon.
          <br><br>
          <b>Generated examples (with a favicon):</b><br>
          <img src="/assets/banners/44706278060c6716a842eb66eebb5477.gif" alt="Generated banner example with favicon" width="468" height="60" border="0"><br>
          <img src="/assets/banners/015feabd027efd4b51df03cda3e69304.gif" alt="Generated banner example with favicon" width="468" height="60" border="0">
          <br><br>
          <b>Generated example (no favicon):</b><br>
          <img src="/assets/banners/e5a93a9442c626960f31d406f150a479.gif" alt="Generated banner example without favicon" width="468" height="60" border="0">
          <br><br>
          <b>Custom banner example:</b><br>
          <img src="/assets/banners/cf71ee03b4fc5888a26ef3c12fb373a1.gif" alt="Custom banner example" width="468" height="60" border="0">
          <br><br>
        </li>
        <li>Compatibility with Old Browsers means any combination of browsers like <b>Netscape</b>, <b>Internet Explorer 1~5</b>, <b>Opera 1~4</b>, <b>NCSA Mosaic</b> and so on. Your website doesn't have to be compatible with all of them to qualify, but it should be compatible with at least a subset of them. Your website <b>does not have to be compatible</b> with old browsers to be a part of the webring.<br>Websites that may be HTML compatible with old browsers but use HTTPs do not count as compatible because they cannot load moder HTTPs sites. Sadly, that includes all Neocities sites.</li>
      </ol>
      <br><br>
    }

    <a href="/">Back to HOME</a>
  })
})
